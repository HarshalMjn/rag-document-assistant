APP_ENV=development

# MySQL (document metadata + chat history)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rag_db
DB_USERNAME=rag_user
DB_PASSWORD=change_me

# Qdrant (vector store)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Embeddings (Google Gemini API via google-genai SDK)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=100

# Chat answers + follow-up rewrites (any OpenAI-compatible API; free key at console.groq.com/keys)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
# Smaller model for rewriting follow-up questions (separate rate limit)
REWRITE_MODEL=openai/gpt-oss-20b

# Chunking (characters)
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=5
# Chunks scoring below this don't count as evidence (0.0-1.0)
MIN_SCORE=0.55

# Uploads
MAX_UPLOAD_MB=10

# Conversation history (latest N messages, user + assistant combined)
HISTORY_LIMIT=10
