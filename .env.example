APP_ENV=development

# MySQL (document metadata + chat history)
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=rag_db
DB_USERNAME=rag_user
DB_PASSWORD=change_me

# Qdrant (vector store)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_API_KEY=
QDRANT_COLLECTION=documents

# Embeddings + LLM (Google Gemini API via google-genai SDK)
GEMINI_API_KEY=
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
LLM_MODEL=gemini-2.5-flash
EMBEDDING_BATCH_SIZE=100

# Chunking (characters)
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# Retrieval
TOP_K=5
# Chunks scoring below this don't count as evidence (0.0-1.0)
MIN_SCORE=0.65

# Uploads
MAX_UPLOAD_MB=10

# Conversation history (latest N messages, user + assistant combined)
HISTORY_LIMIT=10
